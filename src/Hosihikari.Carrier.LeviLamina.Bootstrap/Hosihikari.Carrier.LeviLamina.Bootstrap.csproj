<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hosihikari.Carrier.LeviLamina.Bootstrap</PackageId>
    <Version>26.60.8-r0</Version>
    <Authors>Hosihikari</Authors>
    <Description>LeviLamina carrier bootstrap: loads the shims and registers the (empty) host handle before any component starts.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HosihikariProjection/Capabilities</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>minecraft;bedrock;bds;hosihikari;carrier;levilamina;bootstrap</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hosihikari.Carrier/Hosihikari.Carrier.csproj" />
    <ProjectReference Include="../Hosihikari.Carrier.LeviLamina/Hosihikari.Carrier.LeviLamina.csproj" />
    <ProjectReference Include="$(PluginAbstractionsProjectPath)"
                      Condition="'$(PluginAbstractionsProjectPath)' != ''" />
    <ProjectReference Include="../../../../Framework/Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj"
                      Condition="'$(PluginAbstractionsProjectPath)' == ''" />
    <ProjectReference Include="$(LeviLaminaIdiomaticProjectPath)"
                      Condition="'$(LeviLaminaIdiomaticProjectPath)' != ''" />
    <ProjectReference Include="../../../Binding.Idiomatic/src/Hosihikari.Binding.LeviLamina/Hosihikari.Binding.LeviLamina.csproj"
                      Condition="'$(LeviLaminaIdiomaticProjectPath)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
