<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The adapter registers itself when the contract loads its assembly; that is the
         selection mechanism, not an application startup hook. -->
    <NoWarn>$(NoWarn);CS1591;CA2255</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hosihikari.Extension.Async.LeviLamina</PackageId>
    <Version>26.60.7-r0</Version>
    <Authors>Hosihikari</Authors>
    <Description>LeviLamina adapter for the async capability.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HosihikariProjection/Capabilities</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>minecraft;bedrock;bds;hosihikari;extension;async;levilamina</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hosihikari.Extension.Async/Hosihikari.Extension.Async.csproj" />
    <ProjectReference Include="$(LeviLaminaIdiomaticProjectPath)"
                      Condition="'$(LeviLaminaIdiomaticProjectPath)' != ''" />
    <ProjectReference Include="../../../Binding.Idiomatic/src/Hosihikari.Binding.LeviLamina/Hosihikari.Binding.LeviLamina.csproj"
                      Condition="'$(LeviLaminaIdiomaticProjectPath)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
